PORT=4000
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
CORS_ORIGIN=http://localhost:5173
# Supabase > Project Settings > API. The service role (secret) key bypasses RLS:
# server-side only, never in the frontend or git.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
TOTP_STEP_SECONDS=30
TOTP_WINDOW=1
MAX_CODE_ATTEMPTS=5
# Demo login lets anyone pick a role without a password. Turn off outside the hackathon demo.
DEMO_LOGIN=true

PORT=4000
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
CORS_ORIGIN=http://localhost:5173
# Supabase > Connect > Session pooler. Keep the real value out of git.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
TOTP_STEP_SECONDS=30
TOTP_WINDOW=1
MAX_CODE_ATTEMPTS=5
# Demo login lets anyone pick a role without a password. Turn off outside the hackathon demo.
DEMO_LOGIN=true
